# Browser-safe Supabase values. Fill only after the hosted Supabase checkpoint.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel Preview only: explicitly identify a separately provisioned test project.
# Production's project is always refused in Preview. Leave blank to disable
# authenticated Preview routes while retaining public read-only pages.
PREVIEW_SUPABASE_REF=

# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
ODDS_API_KEY=
